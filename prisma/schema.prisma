// Desk ("Рабочий стол") database — file metadata for the internal manager
// tool at /desk. SQLite is a deliberate starting point (single-server,
// zero external dependency); if the site later moves to a hosted DB, swap
// the adapter in lib/prisma.ts and repoint DESK_STORAGE_DRIVER in
// lib/storage.ts — nothing else in the app needs to change.
//
// Prisma 7: the connection URL lives in prisma.config.ts (CLI/migrations)
// and is passed to a driver adapter at runtime (lib/prisma.ts), not here.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Which tab in the desk a file belongs to.
enum DeskFileTab {
  services
  training
  templates
  calculators
  orders
  quotes
  // Manager cabinet's "База данных" tab — general work files/documents
  // shared across the whole team, not attached to any specific quote/client
  // (relatedId stays null here, same as templates).
  manager_database
  // Manager cabinet's per-client document store — contracts, invoice scans,
  // client-provided specs, etc. relatedId is the Client id.
  manager_client_files
  // Reference photo / spec file(s) a client attached when submitting their
  // own draft quote request from /account. relatedId is the
  // QuoteDraftRequest id. See PB-V5 chat 2026-07-29.
  quote_draft_request
  // Proof (a screenshot of the supplier chat, usually) that a manual cargo
  // rate override (Quote.cargoRateUsdOverride) is a real quoted rate, not
  // guessed — attached by the owner/senior at confirmation time, alongside
  // Quote.cargoRateOverrideCostUsd. relatedId is the Quote id. See PB-V5
  // chat 2026-07-30.
  quote_cargo_rate_proof
  // Same idea as quote_cargo_rate_proof but for a manual ¥→₽ rate
  // (Quote.cnyRateRubOverride) — proof the special rate was actually
  // agreed, not made up. relatedId is the Quote id. See PB-V5 chat
  // 2026-07-30.
  quote_cny_rate_proof
  // Same idea again, for a manual $→₽ rate (Quote.usdRateRubOverride).
  // relatedId is the Quote id. See PB-V5 chat 2026-08-02.
  quote_usd_rate_proof
  // Same idea again, for a manual buyout-commission % override
  // (Quote.buyoutCommissionPercentOverride). relatedId is the Quote id.
  // See PB-V5 chat 2026-07-31.
  quote_buyout_commission_proof
}

model DeskFile {
  id           String      @id @default(cuid())
  tab          DeskFileTab
  // Which card/section within the tab this file is attached to — e.g. a
  // service slug, a training module id, a calculator/deal reference, or
  // (for tab: orders) an Order id.
  // Nullable: templates-tab files aren't attached to a sub-item.
  relatedId    String?
  storageKey   String // key/path used by lib/storage.ts to fetch the blob
  originalName String
  mimeType     String
  size         Int
  uploadedAt   DateTime    @default(now())
  // Who uploaded it — only ever set for tab: manager_database (the old
  // shared-password /desk tool has no concept of a manager identity).
  // SetNull on delete: removing a manager shouldn't delete or orphan the
  // files they uploaded, just anonymize the attribution.
  uploadedByManagerId String?
  uploadedByManager   Manager?    @relation(fields: [uploadedByManagerId], references: [id], onDelete: SetNull)

  @@index([tab, relatedId])
}

// Client portal ("Личный кабинет") — clients log in to see their own orders,
// status history, and documents. Clients/orders are created and managed by
// staff through /desk; clients only ever read their own data plus log in /
// set their password. See lib/client-auth.ts for the session mechanics.

enum OrderDirection {
  start
  business
  factory
  logistics
  fulfillment
  ai
  academy
}

enum OrderStatus {
  new
  in_progress
  shipping
  done
  cancelled
}

// Where a client first came from — collected once, on creation, in the
// manager cabinet's "Новый клиент" form (Раздел 1). Nullable because every
// Client created before this field existed (and any created via the older
// /desk "Клиенты" tab) has none.
enum ClientSource {
  instagram
  telegram
  website
  referral
  other
}

// Manual, manager-set status — same "plain dropdown, no derived logic"
// design as Quote.status (see QuoteStatus in lib/quote-statuses.ts), just
// four values reflecting where the RELATIONSHIP with this client stands,
// independent of any individual quote's own status. See PB-V5 chat
// 2026-08-03.
enum ClientStatus {
  new
  making_quotes
  rejected
  no_active_requests
}

model Client {
  id           String   @id @default(cuid())
  // Short human-friendly number shown in the desk UI ("Клиент №N") — the
  // cuid `id` above stays the real primary key/foreign key everywhere else.
  // Assigned in app code (lib/display-ids.ts) as max(displayId)+1, since
  // SQLite only supports autoincrement on the table's own primary key.
  displayId    Int      @unique
  // Optional at creation (manager cabinet form) — a client without an email
  // simply never gets /account portal access (that login is keyed by
  // email), same as an unactivated manager/client account today.
  email        String?  @unique
  name         String
  company      String?
  // Telegram/WeChat handle — a distinct contact channel from phone/email,
  // collected in the manager cabinet's "Новый клиент" form.
  messenger    String?
  phone        String?
  country      String?
  city         String?
  source       ClientSource?
  // See ClientStatus above — manually set, defaults to "new" for every
  // freshly created client (manager cabinet or self-registration alike).
  status       ClientStatus @default(new)
  // Which manager brought in this client — null for clients created before
  // this field existed or via the older shared-password /desk "Клиенты" tab.
  // Needed for KPI attribution ("новых клиентов за месяц" per manager).
  createdByManagerId String?
  createdByManager   Manager? @relation(fields: [createdByManagerId], references: [id])
  // Manager-initiated claim ("этот клиент — мой личный") — required before
  // it shows up in the owner/senior confirmation queue, so ordinary
  // inbound/marketing clients (the vast majority) never clutter that queue
  // just because createdByManagerId happens to be set.
  selfSourcedClaimed   Boolean   @default(false)
  selfSourcedClaimedAt DateTime?
  // Owner/senior-only confirmation that createdByManagerId genuinely
  // self-sourced this client (not just whoever happened to click "Новый
  // клиент" for an inbound lead) — drives the 35% (vs the usual 10%)
  // premium rate on that manager's quotes for this client. The confirmer
  // is tracked separately from createdByManagerId precisely because they
  // must be a different person by design (conflict-of-interest control,
  // same reasoning as buyout-fact confirmation on Quote below).
  selfSourcedConfirmed           Boolean   @default(false)
  selfSourcedConfirmedAt         DateTime?
  selfSourcedConfirmedByManagerId String?
  // Senior/owner-only manual toggle — hides phone/email/messenger from the
  // currently assigned manager (createdByManagerId) until explicitly
  // allowed. Deliberately independent of selfSourcedConfirmed above (that
  // one only drives premium rate) — a company-sourced lead that gets
  // assigned to a manager should stay contact-hidden even if nobody has
  // claimed/confirmed it as self-sourced. Auto-set true whenever a client
  // is transferred to a new manager (see PATCH .../[id]); senior/owner can
  // flip it back at any time from the client card.
  contactsHiddenFromManager Boolean @default(false)
  // Owner-only override of every "percent_of_profit"-type Investor's rate
  // (see Investor model) for this one client — originally added just for
  // Влад (hence the name, kept for backward compat), who occasionally asks
  // to waive or reduce his cut on a specific deal (a personal friend/
  // acquaintance, or just a favor). Now applies uniformly to every
  // percent_of_profit investor for this client, not one specific person —
  // there's no per-investor-per-client override matrix, a deliberate
  // simplification since this is rare and owner-only to begin with. null =
  // use each investor's own global rate; a number (including 0) overrides
  // all of them for every quote/fulfillment order this client has, live
  // (not snapshotted). Never exposed to a non-owner session — same
  // confidentiality boundary as the rest of "Руководящий состав". See
  // PB-V5 chat 2026-07-30, generalized 2026-07-31.
  vladShareRatePercentOverride Decimal?
  // Null until the client opens their activation link and sets a password —
  // an account can exist (created by staff) before it's ever activated.
  passwordHash String?
  // Deactivated clients can no longer log into /account (checked in
  // app/api/account-login/route.ts) — a soft block, not a delete, so their
  // orders/history stay intact.
  active       Boolean  @default(true)
  // Manager-cabinet archive (distinct from `active` above, which gates
  // /account portal login) — archived clients drop out of the default
  // "Клиенты" list but stay fully intact, toggle-able back via the
  // "Показывать архивные" switch. Null = not archived.
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  orders       Order[]
  quotes       Quote[]
  cashOrders   CashOrder[]
  fulfillmentOrders FulfillmentOrder[]
  quoteDraftRequests QuoteDraftRequest[]
  dailyPlanItems DailyPlanItem[]
  containerShipments ContainerShipment[]

  @@index([createdByManagerId])
}

// Personal login for procurement/sourcing managers at /desk/manager — unlike
// /desk's single shared password, this is a real per-person account, needed
// so KPI/bonus data can be attributed to a specific manager. Anton (the
// owner) is himself a Manager row with role "owner", not a separate system —
// the only difference is which pages his role unlocks.
enum ManagerRole {
  manager
  // Старший менеджер — sees/can act on their own clients plus every
  // client created by managers attached to them via supervisorId below.
  // Same tariff-edit rights as a plain manager (gated by canEditTariffs,
  // not automatically granted by this role).
  senior
  owner
  // Менеджер-аутсорсинг — same scope/rights as a plain "manager" (only
  // their own clients, same actions), except: (1) "Тарифы" and "База
  // данных" tabs are hidden in manager-workspace.tsx (see ALL_SECTIONS),
  // and (2) every client/quote number shown in THIS role's own UI is a
  // small per-manager sequence (№1, №2… for clients; №1_1, №1_2, №2_1…
  // for quotes — client's local number underscore that client's own
  // quote count) instead of the real company-wide displayId, so this
  // person can never estimate total company volume from the numbers they
  // see. The real displayId is completely unchanged in the database and
  // in every other role's view, PDF, export, or cross-reference — see
  // lib/desk-services/outsource-numbering.ts. See PB-V5 chat 2026-08-06.
  outsource_manager
}

model Manager {
  id                 String      @id @default(cuid())
  displayId          Int         @unique
  email              String      @unique
  name               String
  role               ManagerRole @default(manager)
  // Null until the manager opens their activation link and sets a password —
  // same activate-before-first-login shape as Client.passwordHash.
  passwordHash       String?
  active             Boolean     @default(true)
  // Owner-controlled permission gate for POST /api/manager-tariffs — owner
  // can always edit regardless of this flag; everyone else (manager or
  // senior) needs it explicitly turned on. Default false: a newly created
  // manager can read tariffs (needed to build quotes) but not change them
  // until the owner opts them in.
  canEditTariffs     Boolean     @default(false)
  // Individually owner-grantable permissions, same shape/spirit as
  // canEditTariffs above (owner always has every one of these regardless of
  // the stored value; everyone else needs it explicitly turned on from
  // Сотрудники) — each gates one previously hardcoded "owner-only" tab/
  // action that a specific trusted manager or senior manager might
  // plausibly need without promoting them to a whole new role. Checked live
  // via lib/manager-scope.ts, never trusted from the session token, same as
  // canEditTariffs. Default false for everyone: migrating this in changes
  // nothing until the owner opts a specific person in. See PB-V5 chat
  // 2026-08-06.
  //
  // "Прайс-лист" tab — create/edit/delete ServiceCatalogItem rows (reading
  // the catalog to attach a service to a quote was always open to everyone).
  canViewPriceList Boolean @default(false)
  // "Отчёты по дням" tab — the whole cash ledger (CashOrder/CashCategory/
  // opening balance), company-wide, not scoped to the manager's own clients.
  canViewCash Boolean @default(false)
  // "Отчёт о прибыли" tab, both modes — "по выбранным сделкам"
  // (/api/manager-profit-report) and "реальные деньги за период"
  // (/api/manager-period-report). Reveals other managers' premiums and
  // every investor's cut, not just this manager's own numbers — a bigger
  // grant than it might look like from the tab name alone.
  canViewProfitReport Boolean @default(false)
  // "Корзина" tab — browse and restore soft-deleted quotes (deliberately
  // stricter than everything else in this list per an earlier explicit
  // instruction that only the owner gets the final word on undoing a
  // deletion; this override exists because the owner is still the one
  // deciding to grant it, not because the restriction itself is being
  // relaxed by default).
  canViewTrash Boolean @default(false)
  // Real cargo purchase cost/margin (Quote.cargoCostUsd/cargoCostRub) —
  // owner-confidential everywhere else (see stripCargoCostForNonOwner in
  // lib/desk-services/quote-request.ts); useful for a senior manager who
  // needs to manage their own team's real profitability without full owner
  // access.
  canViewCargoCost Boolean @default(false)
  // Self-relation for the "старший менеджер" hierarchy: a manager attached
  // to a senior manager via supervisorId shows up in that senior's scope
  // (lib/manager-scope.ts) without changing who created their own clients.
  supervisorId       String?
  supervisor         Manager?    @relation("ManagerSupervisor", fields: [supervisorId], references: [id])
  subordinates       Manager[]   @relation("ManagerSupervisor")
  // Drives the 2-month probation window from the KPI spec (month 1 =
  // training/adaptation, no real KPI; month 2+ = full KPI) — stored per
  // manager rather than hardcoded so it survives someone starting mid-month
  // and so the probation length itself can differ per hire if ever needed.
  probationStartedAt DateTime    @default(now())
  probationMonths    Int         @default(2)
  createdAt          DateTime    @default(now())

  clients        Client[]
  quotes         Quote[]
  deletedQuotes  Quote[] @relation("QuoteDeletedBy")
  tariffUpdates  TariffSettings[]
  systemSettingsUpdates SystemSettings[]
  investorUpdates Investor[]
  uploadedFiles  DeskFile[]
  cashOrders     CashOrder[]
  quotePaymentAllocations QuotePaymentAllocation[]
  cashOpeningBalanceUpdates CashOpeningBalance[]
  fulfillmentOrders FulfillmentOrder[]
  completedFulfillmentServices FulfillmentOrderItemService[]
  quoteDraftRequests QuoteDraftRequest[]
  dailyPlanItems DailyPlanItem[]
  containerShipments ContainerShipment[]
}

// Which tier of the "Поиск товара" service a quote is billed under — the
// three fixed prices from the approved price list (Standard/Expert/Pro).
// The actual ₽ amount lives on TariffSettings (owner-editable, not a
// hardcoded constant) — this enum only names which tier was picked.
enum QuoteType {
  standard
  expert
  pro
}

// How the manager told the calculator to work out the cargo volume — three
// input paths the spec explicitly asks for, all converging on the same
// stored totalVolumeM3 field so the rest of the formula chain doesn't care
// which path was used.
enum VolumeInputMode {
  per_unit_dims
  total_dims
  manual_total
  // Manager knows the volume of a single unit (e.g. from a supplier spec
  // sheet) but not its L×W×H — totalVolumeM3 = unitVolumeM3 * quantity.
  // See PB-V5 chat 2026-08-02.
  per_unit_volume
}

// Cargo pricing can be worked out two ways — matches the calculators-tab.tsx
// "по плотности" (density-tiered $/kg, looked up from DensityTariff) vs
// "по объёму" (flat $/cbm from TariffSettings.volumeRateUsdPerCbm) split the
// manager already uses in the old cargo calculator, now reused here.
enum DeliveryPricingMode {
  density
  volume
}

// Where the cargo actually ships to — every DensityTariff/VolumeTariff row
// is scoped to exactly one of these (see both models below), and a Quote
// picks one up front (the very first field in the create form) before
// category/rate lookups can even happen, since which categories/rates
// exist depends entirely on this. Only russia has real tariffs as of
// 2026-08-02 — the other three exist so the owner can fill in rates later
// without another schema change; quoting for one of them before its
// tariffs are filled in fails loudly (see lookupDensityRate/
// lookupVolumeRate in lib/quote-engine.ts — empty tiers for a country
// throws the same "нет тарифа" error as an empty category always has).
// See PB-V5 chat 2026-08-02.
enum DestinationCountry {
  russia
  kazakhstan
  kyrgyzstan
  uzbekistan
}

// Daily manager input ("Тарифы" tab): FX rates, the flat volume-based cargo
// rate, the buyout-commission percentage, and the three fixed service
// prices. Append-only (a new row per save, not an overwritten singleton) so
// a Quote can snapshot exactly which rates were in effect when it was
// created — the "current" settings are just the newest row by createdAt,
// same snapshot-over-silent-recompute philosophy as Order.price.
model TariffSettings {
  id                       String   @id @default(cuid())
  // The "от 1000¥" tier — the floor/default rate, and the only one
  // that's always required. Used as-is by everything in the app that
  // doesn't care about volume tiers; a NEW quote (not yet knowing its own
  // final ¥ total) starts priced off this one too, before
  // pickCnyRateForTotal in lib/quote-engine.ts can pick a better tier once
  // there's a quantity/price to compute a total from. See PB-V5 chat
  // 2026-07-31.
  cnyRateRub               Decimal
  // The other three volume tiers the exchange group posts (от 3000¥/
  // 10000¥/30000¥) — nullable because they only ever get populated by the
  // Telegram webhook (see TelegramCnyRateUpdate below); a manually-edited
  // Тарифы save can leave them unset, in which case pickCnyRateForTotal
  // just always falls back to cnyRateRub above, same as before this
  // feature existed.
  cnyRateRubTier3000       Decimal?
  cnyRateRubTier10000      Decimal?
  cnyRateRubTier30000      Decimal?

  // "1 USDT = X¥" — the real cost-basis rate the руководитель actually gets
  // when cashing out, entered manually after each real deal (unlike
  // cnyRateRub* above, there is no reliable live/bot-parsed source for
  // this — the channel's posted USDT table is indicative, not the
  // executed rate). Used by the "Счёт на выкуп" invoice feature to bill a
  // client in USDT: ₽ → ¥ via the quote's own frozen cnyRateUsed, then
  // ¥ → USDT via this rate. Owner/senior-only field (see canEditTariffs in
  // lib/manager-scope.ts) — same append-only carry-forward rule as every
  // other Тарифы field: unchanged unless a save explicitly sends a new
  // value. Changing the value resets usdtRateCnyConfirmed to false, same
  // as Quote.usdRateOverrideConfirmed's reset-on-change rule — a regular
  // manager can't issue a USDT invoice until this is confirmed again (see
  // app/api/manager-quotes/[id]/buyout-invoice/route.ts). See PB-V5 chat
  // 2026-08-03.
  usdtRateCny                  Decimal?
  usdtRateCnyConfirmed         Boolean   @default(false)
  usdtRateCnyConfirmedByManagerId String?
  usdtRateCnyConfirmedAt       DateTime?

  // Owner-only profit accounting — how many ₽ of profit PB actually earns
  // per ¥ converted at each of the same four volume tiers above. NOT part
  // of what the client is charged (that's cnyRateRub* above) — this is
  // purely internal: what to show as "курсовая разница" for a quote
  // BEFORE a real buyout is confirmed (see estimatedFxProfitRub in
  // lib/desk-services/quote-profit.ts), since the factual formula only
  // knows the real spread once actualBuyoutCny/actualBuyoutRateUsed exist.
  // All nullable — missing tier = 0 contribution from that bracket, same
  // convention as cnyRateRubTier3000 etc. See PB-V5 chat 2026-07-31.
  cnyProfitPerYuanRub          Decimal?
  cnyProfitPerYuanRubTier3000  Decimal?
  cnyProfitPerYuanRubTier10000 Decimal?
  cnyProfitPerYuanRubTier30000 Decimal?
  usdRateRub               Decimal
  // Flat rate used when a quote's delivery is priced "по объёму" instead of
  // by density — spec explicitly calls this a temporary placeholder value
  // the manager will tune ("пока ставим временно 340$").
  volumeRateUsdPerCbm      Decimal
  // Buyout/purchasing-organization commission is no longer a single flat
  // rate here — see BuyoutCommissionTariff below (graduated by the goods
  // amount, "сумма закупа"). See PB-V5 chat 2026-07-30.
  standardPriceRub         Decimal
  expertPriceRub           Decimal
  proPriceRub              Decimal
  // "Производство под заказ" service fee, per search tier — a made-to-order
  // product needs extra factory coordination beyond a normal search, so
  // it's billed as its own tier-priced add-on (see Quote.isCustomProduction
  // below), same editable-placeholder reasoning as standardPriceRub etc.
  // See PB-V5 chat 2026-07-29.
  customProductionStandardRub Decimal @default(1000)
  customProductionExpertRub   Decimal @default(2000)
  customProductionProRub      Decimal @default(3000)
  // Manager's flat cargo compensation for a CONFIRMED SELF-SOURCED client
  // only (2026-07-28 motivation policy, corrected same day — a company
  // lead earns the manager nothing from cargo at all; see
  // app/api/manager-dashboard). Whichever basis the quote actually prices
  // cargo on (weight vs volume — same density>=100 rule as
  // actualize-cargo) determines which rate applies. Editable like the
  // other plain rate fields above (not owner-confidential margin data),
  // gated by canEditTariffs same as everything else here.
  managerCargoRateUsdPerKg  Decimal @default(0.3)
  managerCargoRateUsdPerM3  Decimal @default(5)
  // Owner-confidential cargo margin baked into every rate above: every
  // density-tier ratePerKgUsd already has this much profit added on top of
  // the real cost, and volumeRateUsdPerCbm has cargoVolumeMarginUsdPerCbm
  // added. GET /api/manager-tariffs strips both fields for non-owner
  // sessions — a manager needs the sell rate to price a quote, never the
  // margin baked into it. Rates change; the owner's convention is that the
  // margin itself stays put, which is exactly why it's a separate editable
  // field instead of derived from a "cost" field that would drift with
  // every rate update.
  cargoDensityMarginUsdPerKg Decimal @default(1.2)
  cargoVolumeMarginUsdPerCbm Decimal @default(50)
  createdAt                DateTime @default(now())
  createdByManagerId       String
  createdByManager         Manager  @relation(fields: [createdByManagerId], references: [id])
}

// Operating knobs that used to be hardcoded constants scattered across
// lib/quote-engine.ts, lib/desk-services/quote-request.ts, and
// app/api/manager-dashboard/route.ts — moved here (owner-editable from the
// new "Настройки" tab) so tweaking a premium rate or a policy threshold no
// longer needs a code change + deploy. Unlike TariffSettings (append-only —
// every save is a new row, so an already-issued quote keeps the numbers it
// was quoted with), this is a SINGLETON updated in place: nothing here is
// snapshotted onto a Quote, every read (dashboard premium math, the
// density/volume threshold, the free-quote count) always uses today's
// value, exactly like the hardcoded constants did before. See
// lib/system-settings.ts for the find-or-create-with-defaults accessor,
// and PB-V5 chat 2026-07-30.
model SystemSettings {
  id String @id @default(cuid())

  // 2026-07-28 motivation policy rates (see app/api/manager-dashboard's own
  // comment for the full policy writeup) — company-lead vs self-sourced
  // rates on Просчёт/Выкуп, and the fulfillment premium rate. Investor cuts
  // (Влад/Юра/etc. — used to be fixed fields here) moved to the Investor
  // model below on 2026-07-31, so the roster/rates/count can change from
  // «Настройки» → «Руководящий состав» without a schema change.
  normalRatePercent                    Decimal @default(10)
  selfSourcedProscetRatePercent        Decimal @default(100)
  selfSourcedBuyoutDiscountRatePercent Decimal @default(50)
  fulfillmentPremiumRatePercent        Decimal @default(10)

  // How many of a client's first Standard-tier quotes get the search fee
  // waived — see FREE_STANDARD_QUOTE_LIMIT's old home in quote-request.ts.
  freeStandardQuoteLimit Int @default(3)

  // Below this density (kg/m³), cargo always prices "по объёму" regardless
  // of the quote's own deliveryPricingMode — see
  // LOW_DENSITY_VOLUME_THRESHOLD_KG_M3's old home in lib/quote-engine.ts.
  lowDensityVolumeThresholdKgM3 Decimal @default(100)

  // Dashboard hint-text blocks (components/manager/manager-dashboard.tsx) —
  // plain text, "**слово**" renders bold (see FormattedText in that file).
  // Blank/default seed text mirrors exactly what used to be hardcoded JSX,
  // so migrating to this table doesn't change anything a manager sees until
  // an owner actually edits it from Настройки.
  premiumExplanationText String @default("")
  incomeSummaryText      String @default("")
  incomeDetailText       String @default("")

  updatedAt          DateTime @updatedAt
  updatedByManagerId String
  updatedByManager   Manager  @relation(fields: [updatedByManagerId], references: [id])
}

// A partner/investor entitled to a cut of company profit — replaces the
// fixed Влад/Юра/Александр/Антон fields that used to live directly on
// SystemSettings and be hardcoded by name throughout app/api/manager-
// dashboard/route.ts, lib/desk-services/profit-report.ts, and their
// frontends. Owner-only ("Настройки" → "Руководящий состав"), singleton-
// style like SystemSettings (live — a rate change applies to every past
// AND future deal the next time totals are computed, never snapshotted
// onto a Quote; matches how vladShareRatePercent already behaved before
// this model existed). See PB-V5 chat 2026-07-31.
model Investor {
  id String @id @default(cuid())
  name String
  // Lower shows first — purely display order, doesn't affect the split.
  sortOrder Int @default(0)
  // Soft-disable instead of delete — keeps a former investor's name
  // resolvable in old references without them counting in new splits.
  active Boolean @default(true)
  // "percent_of_profit": ratePercent × this deal's clamped total profit
  //   (every source: Просчёт+Выкуп+Скидка+Курсовая разница+Карго) — same
  //   math as Влад's cut always used. Client.vladShareRatePercentOverride
  //   (still that name for backward compat) applies to every investor of
  //   this type uniformly for that one client, not just one specific
  //   investor — there's no per-investor-per-client override matrix, a
  //   deliberate simplification (see that field's own comment).
  // "flat_per_cargo_kg": rateUsdPerKg × a quote's delivered cargo weight
  //   (converted at that quote's own usdRateUsed) — same math as Юра's
  //   cut always used, on every cargo delivery regardless of self-sourced
  //   status.
  // "remainder_share": splits whatever's left after every percent_of_profit
  //   and flat_per_cargo_kg cut (and every manager premium) evenly among
  //   all ACTIVE remainder_share investors — same math the hardcoded "/2"
  //   for Александр+Антон always did, generalized to N-way.
  shareType String
  ratePercent   Decimal?
  rateUsdPerKg  Decimal?
  // Free text — where the payout actually goes (bank details, a crypto
  // address, "нал", anything). Purely informational, never read by any
  // calculation — just so the owner doesn't have to remember it elsewhere.
  paymentChannel String?
  note           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  updatedByManagerId String
  updatedByManager   Manager  @relation(fields: [updatedByManagerId], references: [id])
  linkedCashCategories CashCategory[]
}

// One row per density tier per cargo category — e.g. "Одежда, 150-160
// kg/m³, $4.1/kg". A quote looks up the single matching row for its
// category + computed density and snapshots the rate it found onto
// Quote.cargoRateUsd, so a later edit to this table never changes an
// already-issued quote's numbers. categoryKey/categoryLabel are plain
// strings (not an enum) so the manager can add a new cargo category from
// the Тарифы tab without a schema migration.
model DensityTariff {
  id            String   @id @default(cuid())
  // Which country's cargo this tier prices — see DestinationCountry above.
  // Defaults to russia so every pre-existing row (the only tariffs that
  // ever existed before 2026-08-02) backfills correctly.
  destinationCountry DestinationCountry @default(russia)
  categoryKey   String
  categoryLabel String
  // Upper bound of this tier, exclusive — null means "no upper bound" (the
  // top tier, e.g. 300-400 kg/m³ and above).
  minDensity    Decimal
  maxDensity    Decimal?
  ratePerKgUsd  Decimal
  // Owner-confidential real cost per kg for this specific category — unlike
  // TariffSettings.cargoDensityMarginUsdPerKg (a single global default used
  // only to pre-fill this field for a brand-new tier), cost genuinely
  // varies by category, so it's tracked per-row and owner-editable here.
  // margin for a given tier = ratePerKgUsd - costPerKgUsd. GET
  // /api/manager-density-tariffs strips this for non-owner the same way
  // /api/manager-tariffs strips the global margin fields.
  costPerKgUsd  Decimal  @default(0)
  createdAt     DateTime @default(now())

  @@index([destinationCountry, categoryKey])
}

// Per-category "по объёму" ($/m³) rate — e.g. "Мелкий хозяйственный товар"
// ships cheaper per m³ than "Большой хозяйственный товар" even though both
// are priced by volume, not weight. One row per category (not tiered like
// DensityTariff — volume rate doesn't vary by density, only by category).
// Used both when a quote is explicitly priced "по объёму" and as the
// low-density (<100 kg/m³) fallback for a "по плотности" quote — see
// LOW_DENSITY_VOLUME_THRESHOLD_KG_M3 in lib/quote-engine.ts. A quote
// snapshots whichever rate it found onto Quote.cargoRateUsd, so editing
// this table never changes an already-issued quote's numbers.
model VolumeTariff {
  id            String   @id @default(cuid())
  // See DensityTariff.destinationCountry above — same reasoning, same
  // default. categoryKey alone used to be globally unique; now it only
  // needs to be unique per country (Kazakhstan can have its own "Одежда"
  // row once its rates are filled in, independent of Russia's).
  destinationCountry DestinationCountry @default(russia)
  categoryKey   String
  categoryLabel String
  rateUsdPerCbm Decimal
  // Owner-confidential real cost per m³ — same reasoning as
  // DensityTariff.costPerKgUsd.
  costUsdPerCbm Decimal  @default(0)
  createdAt     DateTime @default(now())

  @@unique([destinationCountry, categoryKey])
}

// Graduated buyout/purchasing-organization commission — replaces the old
// single flat TariffSettings.buyoutCommissionPercent (2026-07-30, per
// owner's own tier table: bigger orders earn a lower %). One row per
// bracket of "сумма закупа" (goods cost only — Quote.totalPriceRub, NOT
// including China-domestic delivery, same "закуп = стоимость товара"
// reading the owner confirmed). minAmountRub is inclusive, maxAmountRub is
// the upper bound, exclusive — null means "no upper bound" (the top
// bracket), same null-is-open-ended convention as DensityTariff.maxDensity.
// A quote snapshots whichever rate it matched onto Quote.buyoutCommissionPercent,
// so editing this table never changes an already-issued quote's numbers.
model BuyoutCommissionTariff {
  id                String   @id @default(cuid())
  minAmountRub      Decimal
  maxAmountRub      Decimal?
  commissionPercent Decimal
  createdAt         DateTime @default(now())
}

// Free-form status list, not a strict blocking workflow — same
// pick-any-status philosophy as the older Order/OrderStatusEvent pipeline
// in /desk, just without a separate history table (statusChangedAt below is
// enough to drive the "stuck in progress" warning; nothing here needs a
// full audit trail yet).
enum QuoteStatus {
  new_request // новая заявка
  in_progress // взят в работу
  pending_approval // на согласовании
  approved_by_client // согласовано клиентом
  needs_replacement // нужна замена — this specific product won't work, still an active deal (see PB-V5 chat 2026-07-28)
  rejected // отказ
  awaiting_payment // ждём оплату
  need_to_buyout // нужно выкупить — money's in, goods not bought yet
  in_transit_to_warehouse // в доставке на склад
  delivered_to_warehouse // доставлен на склад
  sent_to_client // отправлен клиенту
  handed_to_client // выдан клиенту
}

model Quote {
  id       String  @id @default(cuid())
  displayId Int    @unique
  clientId String
  client   Client  @relation(fields: [clientId], references: [id])
  managerId String
  manager  Manager @relation(fields: [managerId], references: [id])

  status          QuoteStatus @default(new_request)
  // Bumped on every status change (not just createdAt) — lets the UI show
  // "stuck in progress for >24h" without a separate history table.
  statusChangedAt DateTime    @default(now())
  // Soft delete — DELETE /api/manager-quotes/[id] sets this instead of
  // actually removing the row, so a deleted quote can sit in "Корзина" for
  // 14 days and be restored (owner-only — see confirm-restore semantics in
  // app/api/manager-quotes/[id]/restore/route.ts) before
  // scripts/purge-deleted-quotes.sh permanently removes it. Every "normal"
  // Quote query in the app must filter deletedAt: null — a soft-deleted
  // quote must vanish from every list, dashboard total, and profit/premium
  // calculation immediately, not just the visible quote lists. See PB-V5
  // chat 2026-08-04.
  deletedAt           DateTime?
  deletedByManagerId  String?
  deletedByManager    Manager?  @relation("QuoteDeletedBy", fields: [deletedByManagerId], references: [id])
  // Set ONCE, the first time this quote ever reaches pending_approval —
  // never overwritten by later status changes (even a rollback or a later
  // needs_replacement/rejected doesn't clear it). Drives the owner's
  // "готовые просчёты за день/неделю/месяц" count in the dashboard — the
  // manager did the calculation work the moment this was true, regardless
  // of what happens to the deal afterward. See PB-V5 chat 2026-07-28.
  completedAt     DateTime?

  quoteType           QuoteType
  // Snapshot of the chosen tier's price at creation time (from
  // TariffSettings), editable per quote afterwards if the manager wants to
  // give a discount — same reasoning as Order.price's own snapshot comment.
  searchServiceFeeRub Decimal
  // True when this quote landed in the client's first-3-Standard-quotes
  // promo (searchServiceFeeRub forced to 0 at creation) — kept as its own
  // flag rather than inferred from searchServiceFeeRub==0 so the PDF can
  // show "БЕСПЛАТНО" specifically for the promo case, not for an unrelated
  // manual discount down to zero.
  searchFeeWaived     Boolean   @default(false)

  // "Производство под заказ" — the manager flags a made-to-order product,
  // billing the tier-priced service from TariffSettings.customProduction*Rub
  // (snapshotted here at creation/quote-type-change time, same reasoning as
  // searchServiceFeeRub — the owner can change the rate later without
  // rewriting already-quoted totals). Zero/false for a normal off-the-shelf
  // product. See PB-V5 chat 2026-07-29.
  isCustomProduction     Boolean @default(false)
  customProductionFeeRub Decimal @default(0)

  // "Только карго" — product data (name/price/weight/dims/photos) is still
  // entered and stored exactly like a normal quote, but totalRub (see
  // computeQuote in lib/quote-engine.ts) collapses to cargoDeliveryRub
  // alone — no goods price, China delivery, search-service fee, buyout
  // commission, "производство под заказ", or attached services. Packaging/
  // insurance/MSK expenses (added later at actualize-cargo time) still
  // apply on top, same as any other quote. Client already sources the
  // goods themselves; Panda Bridge only prices and delivers the cargo leg.
  // Manual cargoRateUsdOverride/usdRateRubOverride stay fully functional —
  // this flag only changes which lines feed totalRub and the PDF, not how
  // any of them are computed. Profit/premium math (see
  // lib/desk-services/quote-profit.ts) also gates on this: a cargo-only
  // quote's company profit is cargo margin alone, never the goods/search/
  // buyout-commission fields that were entered for record-keeping but
  // never actually billed to the client. See PB-V5 chat 2026-08-06.
  isCargoOnly Boolean @default(false)

  productName        String
  // Never shown on the client-facing PDF export — internal only.
  productLink        String?
  productDescription String?
  color              String?
  dimensions         String?
  quantity           Int

  priceCnyPerUnit  Decimal
  priceRubPerUnit  Decimal
  totalPriceCny    Decimal
  totalPriceRub    Decimal

  chinaDeliveryCny Decimal @default(0)
  chinaDeliveryRub Decimal @default(0)

  weightPerUnitKg  Decimal
  totalWeightKg    Decimal

  volumeInputMode    VolumeInputMode
  unitLengthCm       Decimal?
  unitWidthCm        Decimal?
  unitHeightCm       Decimal?
  totalLengthCm      Decimal?
  totalWidthCm       Decimal?
  totalHeightCm      Decimal?
  // Only meaningful when volumeInputMode is per_unit_volume — the entered
  // per-unit m³, before multiplying by quantity (see totalVolumeM3 below).
  unitVolumeM3       Decimal?
  // Always populated regardless of volumeInputMode — the one number the
  // rest of the formula chain (density, cargo rate) actually reads.
  totalVolumeM3      Decimal

  densityKgM3 Decimal

  // Chosen at the very first step of creating a quote (see quote-dialog.tsx)
  // — decides which DensityTariff/VolumeTariff rows are even eligible to
  // look up a rate from, so it has to be known before cargo category/rate
  // selection can happen at all. Snapshotted here same as every other
  // pricing input; changing this on an edit re-picks the category the same
  // way switching deliveryPricingMode already does. See DestinationCountry
  // above, PB-V5 chat 2026-08-02.
  destinationCountry  DestinationCountry  @default(russia)
  deliveryPricingMode DeliveryPricingMode
  // Only meaningful when deliveryPricingMode is "density".
  cargoCategoryKey    String?
  // Snapshot of whichever rate was actually used (density-tier lookup or
  // the flat volume rate) — auditable without re-deriving from tariff
  // tables that may have since changed. This is the undiscounted per-unit
  // sell rate; cargoDiscountUsd below is applied on top of it.
  cargoRateUsd        Decimal
  // Manager-entered manual $/кг or $/м³ rate — when set, cargoRateUsd above
  // is THIS value instead of a DensityTariff/VolumeTariff catalog lookup
  // (a one-off negotiated rate, or a category/density bracket with no
  // catalog entry yet). null = normal catalog lookup, same as before this
  // field existed. Kept separately from cargoRateUsd itself so PATCH/
  // recalculate can tell "the manager typed this on purpose" apart from
  // "this came from the tariff table" and re-apply it rather than
  // silently reverting to auto-lookup — same reasoning as cargoDiscountUsd
  // below. See PB-V5 chat 2026-07-30.
  cargoRateUsdOverride Decimal?
  // A manual cargoRateUsdOverride needs owner/senior sign-off before it's
  // trusted for profit accounting — the sell rate is usable immediately
  // (the client sees a real, final price the moment the quote is made),
  // but cargoCostRub below stays on the generic tariff-margin fallback
  // until confirmed, same "usable now, audited later" split as
  // buyoutFactConfirmed/actualBuyoutCny on this same model. false/null on
  // every quote without an override at all — only meaningful alongside
  // cargoRateUsdOverride being set. A NEW override value (or clearing one)
  // resets all four of these fields back to unconfirmed — see
  // app/api/manager-quotes for where that reset happens.
  cargoRateOverrideConfirmed          Boolean   @default(false)
  // The real supplier cost per кг/м³ (whichever basis this quote's cargo
  // is priced on) the owner/senior enters at confirmation time — replaces
  // the generic DensityTariff/VolumeTariff-derived margin for THIS quote's
  // cargoCostRub once confirmed, since a one-off negotiated rate has no
  // real cost basis in the catalog to fall back on.
  cargoRateOverrideCostUsd            Decimal?
  // Plain string, no Prisma relation — same convention as
  // buyoutConfirmedByManagerId below (resolved with one extra manager
  // lookup where needed, not an include), so Manager doesn't need a
  // dedicated back-relation array for every confirmation-type action.
  cargoRateOverrideConfirmedByManagerId String?
  cargoRateOverrideConfirmedAt        DateTime?
  // Manager-entered discount off the computed cargo charge (e.g. for a big
  // client) — already subtracted into cargoDeliveryUsd/cargoDeliveryRub
  // below, kept here separately so the discount itself stays visible/
  // auditable instead of disappearing into the final number.
  cargoDiscountUsd    Decimal @default(0)
  cargoDeliveryUsd    Decimal
  cargoDeliveryRub    Decimal
  // Owner-confidential: the real cargo cost this quote is snapshotted
  // against (cargoRateUsd's tariff, minus TariffSettings' cargo margin at
  // creation time, times the same weight/volume basis cargoRateUsd used) —
  // independent of cargoDiscountUsd, so a discount correctly eats into
  // margin instead of silently changing what the delivery "actually cost."
  // Never shown to a non-owner; see app/api/manager-dashboard for the only
  // place this is read (cargo profit = cargoDeliveryRub - cargoCostRub).
  cargoCostUsd        Decimal @default(0)
  cargoCostRub        Decimal @default(0)
  // Real per-unit cargo PURCHASE rate — what the company actually paid the
  // carrier for THIS shipment, entered once known (from the real carrier
  // invoice/накладная) in the same "Реальные габариты карго" dialog as
  // actualTotalWeightKg/actualTotalVolumeM3. When set (together with
  // actualCargoCostBasis below), replaces the generic DensityTariff/
  // VolumeTariff-margin-derived cargoCostUsd/cargoCostRub for this quote —
  // deliberately independent of deliveryPricingMode/cargoRateUsd (the
  // CLIENT-facing sell side, already frozen and communicated), since a real
  // carrier invoice can be billed on a totally different basis than what
  // the client was quoted on. null = no real figure yet, cargoCostUsd/
  // cargoCostRub keep coming from the estimated tariff margin, same as
  // before this field existed. Owner-only, same confidentiality boundary as
  // cargoCostRub itself. See actualize-cargo/route.ts, PB-V5 chat
  // 2026-08-05.
  actualCargoCostRateUsd Decimal?
  // Which basis actualCargoCostRateUsd is quoted on ($/kg vs $/m³) — only
  // meaningful alongside actualCargoCostRateUsd being set.
  actualCargoCostBasis   DeliveryPricingMode?

  buyoutCommissionPercent Decimal
  buyoutCommissionRub     Decimal

  // Grand total the client actually pays: goods + China delivery + search
  // service + buyout commission + cargo delivery + производство под заказ
  // (if isCustomProduction) + attached services.
  totalRub Decimal

  // FX rates actually used for this quote — snapshotted from TariffSettings
  // at creation time, independent of whatever the rate is by the time
  // someone reopens this quote later.
  cnyRateUsed Decimal
  usdRateUsed Decimal
  // Manager-entered manual ¥→₽ rate for a special case (client negotiated a
  // specific rate, etc.) — when set, cnyRateUsed above is THIS value instead
  // of TariffSettings.cnyRateRub. null = normal rate, same as before this
  // field existed. Same "typed on purpose, re-apply on edit/recalculate
  // rather than silently reverting" reasoning as cargoRateUsdOverride above.
  cnyRateRubOverride Decimal?
  // Same owner/senior sign-off gate as cargoRateOverrideConfirmed above —
  // the rate is usable immediately (it's already what the client is
  // charged), this just confirms it's a real agreed rate, not made up.
  // Unlike cargo there's no separate "cost" to enter: the profit impact of
  // a non-standard rate already flows through the existing
  // fxProfitRub (actualBuyoutRateUsed vs cnyRateUsed) in
  // app/api/manager-dashboard/route.ts regardless of where cnyRateUsed came
  // from, so confirming here is proof-only.
  cnyRateOverrideConfirmed          Boolean   @default(false)
  cnyRateOverrideConfirmedByManagerId String?
  cnyRateOverrideConfirmedAt        DateTime?

  // Manual $→₽ rate for a special case — same idea as cnyRateRubOverride
  // above, just for the rate cargo delivery is converted at (usdRateUsed).
  // null = normal rate, taken from TariffSettings.usdRateRub (new quote) or
  // frozen from this quote's own snapshot (edit), same as before this field
  // existed. See PB-V5 chat 2026-08-02.
  usdRateRubOverride Decimal?
  // Same owner/senior sign-off gate as cnyRateOverrideConfirmed above —
  // proof-only, no separate cost field (same reasoning as cny: this rate
  // already IS what cargo is converted at, nothing else to enter).
  usdRateOverrideConfirmed          Boolean   @default(false)
  usdRateOverrideConfirmedByManagerId String?
  usdRateOverrideConfirmedAt        DateTime?

  // Manual commission-% override for the buyout — same idea as
  // cargoRateUsdOverride/cnyRateRubOverride above: null = normal
  // BuyoutCommissionTariff bracket lookup by totalPriceRub, same as before
  // this field existed. When set, buyoutCommissionPercent/buyoutCommissionRub
  // above ARE this value instead of a tariff-table lookup. See PB-V5 chat
  // 2026-07-31.
  buyoutCommissionPercentOverride Decimal?
  // Same owner/senior sign-off gate as cnyRateOverrideConfirmed above —
  // proof-only, no separate cost field (same reasoning as cny: the
  // commission IS what the client is charged, nothing else to enter).
  buyoutCommissionOverrideConfirmed            Boolean   @default(false)
  buyoutCommissionOverrideConfirmedByManagerId String?
  buyoutCommissionOverrideConfirmedAt          DateTime?

  // One line each, not a thread — the client and manager each have their
  // own comment slot under a quote, both visible to both sides, but each
  // only writable by its own owner (enforced in the API routes, not here).
  clientComment  String @default("")
  managerComment String @default("")

  // Real buyout economics, entered once goods are actually purchased from
  // the factory — separate from priceCnyPerUnit/totalPriceCny above (the
  // QUOTED price the client agreed to, never touched by this). Owner/senior
  // only, by design: the manager who'd benefit from a smaller reported
  // spend must never be the one reporting it. Null/false until confirmed —
  // status can advance freely regardless (see managerComment-style
  // decoupling), only the dashboard's "факт" bucket and premium depend on
  // this flag, not on Quote.status itself.
  actualBuyoutCny          Decimal?
  actualBuyoutRateUsed     Decimal?
  // Extra factory discount ON TOP of the quoted goods price, entered
  // alongside actualBuyoutCny at the same real rate (actualBuyoutRateUsed)
  // — a distinct profit source from "Выкуп" under the 2026-07 motivation
  // policy ("Скидка поставщика"), not folded into actualBuyoutCny itself.
  // Optional — most deals have none.
  actualSupplierDiscountCny Decimal?
  buyoutFactConfirmed      Boolean   @default(false)
  buyoutConfirmedByManagerId String?
  buyoutConfirmedAt        DateTime?
  // Locked in AT confirmation time — always 10 as of the 2026-07 motivation
  // policy (the old 35%-for-self-sourced multiplier on buyout profit was
  // dropped; a self-sourced client instead gets 100% on Просчёт/Скидка,
  // computed in app/api/manager-dashboard, not stored here). Field kept
  // (rather than hardcoding 10 everywhere) so already-confirmed quotes from
  // before this policy change keep displaying whatever rate they were
  // actually confirmed at (some show 35) — never rewritten retroactively.
  // Also captures whichever manager this quote actually belonged to at the
  // moment of confirmation, independent of any later reassignment via
  // /api/manager-quotes/[id]/reassign.
  buyoutPremiumRatePercent Decimal?
  // Whether this quote's client was a confirmed self-sourced client of the
  // (then-current) manager AT THE MOMENT of buyout confirmation — drives
  // the 100%-on-Просчёт/Скидка dashboard formula. Locked here (not
  // recomputed live off Client.selfSourcedConfirmed) for the exact same
  // reason buyoutPremiumRatePercent above is locked: a client confirmed
  // self-sourced today must never retroactively boost a quote confirmed
  // before that date. Null until buyoutFactConfirmed.
  buyoutSelfSourcedBoost   Boolean?

  // Real payment actually RECEIVED from the client for buyout+services —
  // the mirror of actualBuyoutCny above (that one is the real COST of
  // buying from the factory; this is the real INCOME side). Entered in RUB
  // with its own "1¥=X₽" rate (same convention as CashOrder.cnyToCurrencyRate)
  // so confirming it can create/update a linked income CashOrder in the
  // owner's cash ledger automatically — see confirm-buyout route — instead
  // of the manager having to separately re-enter the same payment by hand
  // in Отчёты по дням.
  actualClientPaymentRub       Decimal?
  actualClientPaymentRateUsed  Decimal?
  clientPaymentCashOrderId     String?    @unique
  clientPaymentCashOrder       CashOrder? @relation("QuoteClientPaymentCashOrder", fields: [clientPaymentCashOrderId], references: [id], onDelete: SetNull)
  // Every ledger entry (see CashOrder.quoteId) manually linked to this
  // quote from the generic "Приходный/Расходный ордер" dialog — distinct
  // from clientPaymentCashOrder above, which is the ONE auto-managed order
  // confirm-buyout itself creates/updates.
  cashOrders                   CashOrder[] @relation("QuoteLedgerCashOrders")

  // Real cargo weight/volume from the warehouse's shipping note, entered
  // (by anyone — no self-report/conflict-of-interest risk here, the price
  // comes from the frozen cargoRateUsd, not something typed in) before the
  // quote can advance to "отправлен клиенту" or later. Recomputing cargo
  // off these — same frozen cargoRateUsd/cargoDiscountUsd, no fresh tariff
  // lookup — overwrites the "live" totalWeightKg/totalVolumeM3/densityKgM3/
  // cargoDeliveryUsd/cargoDeliveryRub/cargoCostUsd/cargoCostRub/totalRub
  // fields above in place (so client portal/PDF pick it up automatically),
  // while the ORIGINAL quoted numbers are preserved below for comparison —
  // "не всегда просчёт равен факту" after the warehouse actually measures
  // it. This exists for the owner's own accurate cargo profit, not manager
  // premium (that's the flat cargoBonusRatePercent below, not a profit
  // share) — see PB-V5 chat 2026-07-27 for why cargo profit-sharing was
  // dropped for managers.
  actualTotalWeightKg  Decimal?
  actualTotalVolumeM3  Decimal?
  // Snapshotted once, at the FIRST actualization only — never touched by a
  // later correction, so "что обещали клиенту изначально" stays intact.
  // Full set (not just the RUB total) so a status rollback can fully
  // restore every field actualize-cargo overwrote, not just some of them.
  estimatedTotalWeightKg    Decimal?
  estimatedTotalVolumeM3    Decimal?
  estimatedDensityKgM3      Decimal?
  estimatedCargoDeliveryUsd Decimal?
  estimatedCargoDeliveryRub Decimal?
  estimatedCargoCostUsd     Decimal?
  estimatedCargoCostRub     Decimal?
  estimatedTotalRub         Decimal?
  cargoActualizedAt         DateTime?
  cargoActualizedByManagerId String?
  // Locked in when status transitions to handed_to_client (0 or 10) — flat
  // % of cargoDeliveryRub (what the client pays for cargo, by then already
  // the actualized real figure), not a cargo profit/margin share. Only
  // nonzero for a confirmed self-sourced client's own manager, mirroring
  // buyoutPremiumRatePercent's snapshot-at-transition-time reasoning.
  cargoBonusRatePercent Decimal?

  // Real extra costs at actual shipment, reported by the кладовщик
  // alongside real weight/volume (see actualize-cargo/route.ts) —
  // packaging materials, cargo insurance, and Moscow consolidation
  // handling. Added to totalRub (what the client owes) but deliberately
  // EXCLUDED from every profit/premium formula in lib/desk-services/
  // quote-profit.ts — pure pass-through, same reasoning chinaDeliveryRub/
  // cargoDeliveryRub are already excluded from the "Выкуп" profit bucket
  // (the company has a real matching cost for each, so counting 100% of
  // it as profit/premium base would be wrong). See PB-V5 chat 2026-08-05.
  packagingCostRub Decimal @default(0)
  insuranceCostRub Decimal @default(0)
  mskExpensesRub   Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachedServices QuoteAttachedService[]
  fulfillmentOrders FulfillmentOrder[]
  containerShipmentItems ContainerShipmentItem[]
  paymentAllocations QuotePaymentAllocation[]

  @@index([clientId])
  @@index([managerId])
}

// Extra Panda Bridge services (from the price list, ServiceCatalogItem)
// attached to a quote alongside the core "поиск товара" fee — e.g.
// packaging, branding, photo shoot. Snapshotted (name/priceRub), not a live
// reference, so deleting or re-pricing a catalog item never changes an
// already-issued quote. serviceCatalogItemId is nullable for the same
// reason (the source item may be deleted later; the snapshot still stands).
// priceRub is entered/confirmed by the manager, not parsed from the
// catalog's free-text price string (see ServiceCatalogItem.price below) —
// that string isn't reliably a clean number ("от 10 000 ₽/ед.").
model QuoteAttachedService {
  id                  String              @id @default(cuid())
  quoteId             String
  quote               Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceCatalogItemId String?
  serviceCatalogItem   ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  name                String
  priceRub            Decimal
  createdAt           DateTime            @default(now())

  @@index([quoteId])
}

// A completely separate shipping method from every Quote's own cargo
// pricing (density/volume tariff, priced per kg/m³) — a manager batches
// several of a client's ALREADY-PRICED quotes into one physical rail
// container instead, and the container's own flat delivery price gets
// split back across those quotes proportionally by volume. Deliberately
// does not touch Quote.cargoDeliveryRub/cargoRateUsd/etc at all — those
// stay exactly what they were, this is an alternate, additional pricing
// view for the same underlying goods, presented on its own PDF. See PB-V5
// chat 2026-08-02.
enum ContainerType {
  ft20
  ft40
}

model ContainerShipment {
  id        String   @id @default(cuid())
  displayId Int      @unique
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  managerId String
  manager   Manager  @relation(fields: [managerId], references: [id])
  containerType ContainerType
  // What the client is charged for the whole container's delivery, in $ —
  // entered by whoever forms the container (any manager), same $
  // denomination as Quote.cargoRateUsd/cargoDeliveryUsd. Split across items
  // proportionally by volume at PDF-render time (see
  // lib/desk-services/container-shipment-pdf.tsx) — not stored per item,
  // since it's a pure function of totalDeliveryUsd and each item's own
  // snapshotted totalVolumeM3 below.
  totalDeliveryUsd     Decimal
  // Owner-confidential real cost of the container delivery — owner-only to
  // enter and see (same confidentiality boundary as Quote.cargoCostUsd),
  // null if a plain manager formed the container without the owner present.
  // Internal profit reference only, never rendered on the client PDF.
  totalDeliveryCostUsd Decimal?
  // $→₽ rate snapshotted at creation (from TariffSettings.usdRateRub, same
  // as Quote.usdRateUsed) — the PDF's ₽ figures need one, and a container
  // is a one-off event, not something that gets edited/re-priced later.
  usdRateRub Decimal
  createdAt  DateTime @default(now())

  items ContainerShipmentItem[]
}

// One line item = one Quote included in a ContainerShipment. Every number
// here is a snapshot taken the moment the quote was added — editing the
// original Quote afterward (or it being recalculated) must never silently
// shift a number on a container PDF that may already be in the client's
// hands, same "frozen at the time" philosophy as Quote's own
// cnyRateUsed/usdRateUsed snapshots.
model ContainerShipmentItem {
  id                  String            @id @default(cuid())
  containerShipmentId String
  containerShipment   ContainerShipment @relation(fields: [containerShipmentId], references: [id], onDelete: Cascade)
  quoteId             String
  quote               Quote             @relation(fields: [quoteId], references: [id])

  productName   String
  color         String?
  dimensions    String?
  quantity      Int
  totalWeightKg Decimal
  totalVolumeM3 Decimal
  // Everything the client owes for this quote EXCEPT cargo delivery (goods
  // + China delivery + search fee + buyout commission + services +
  // производство под заказ) — quote.totalRub minus quote.cargoDeliveryRub
  // at snapshot time. The container's own proportional delivery share
  // (computed from totalVolumeM3 above vs the shipment's total) replaces
  // the quote's original cargo delivery entirely on this PDF.
  goodsAndFeesRub Decimal

  @@unique([containerShipmentId, quoteId])
}

// Catalog of sellable services with prices, picked from a dropdown when a
// manager adds an order to a client (instead of typing a free-text title).
// Seeded once from data/pricing.ts (prisma/seed-service-catalog.ts) so the
// dropdown starts populated with the site's real service list; managers can
// add missing services/prices on the fly from the desk UI afterwards.
model ServiceCatalogItem {
  id        String         @id @default(cuid())
  // Short unique SKU like "ST-014" (direction prefix + sequence within that
  // direction) — assigned in app code (lib/display-ids.ts), shown next to
  // the service name everywhere it's picked or listed.
  code      String         @unique
  direction OrderDirection
  name      String
  price     String
  createdAt DateTime       @default(now())
  orders    Order[]
  attachedToQuotes QuoteAttachedService[]

  @@index([direction])
}

model Order {
  id        String             @id @default(cuid())
  clientId  String
  client    Client             @relation(fields: [clientId], references: [id])
  direction OrderDirection
  title     String
  // Snapshot of the catalog price at the time the order was created — the
  // catalog price may change later, but a client's own order shouldn't.
  price               String?
  serviceCatalogItemId String?
  serviceCatalogItem   ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  status    OrderStatus        @default(new)
  // False only for orders a client placed themselves via the /account cart
  // checkout — lets the desk UI badge the client/order until a manager
  // actually looks at it. Orders a manager creates by hand are inherently
  // already "seen", so this defaults to true.
  seenByManager Boolean        @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  events    OrderStatusEvent[]

  @@index([clientId])
}

// History log of status changes for an order — written alongside every
// Order.status update (same transaction) so the two never drift apart.
model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// One row per "Карточки товара" generation — lets the desk UI show a
// history of past exports (date, product, archive name) and re-download
// the result without paying for a fresh OpenAI generation again.
model ProductCardExport {
  id           String   @id @default(cuid())
  productTitle String
  fileName     String
  storageKey   String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
}

// Owner's manual daily cash ledger ("Отчёты по дням") — a real-money
// record of income/expense orders, tracked entirely separately from the
// Quote-based profit dashboard (that one estimates/confirms profit on
// quotes; this one is the owner's actual кассовая книга for reconciling
// against a real bank/cash balance). Balance is tracked in CNY.
enum CashOrderType {
  income
  expense
}

enum CashCurrency {
  cny
  usd
  rub
}

// Who an expense статья's amount should be auto-suggested for on a new
// order (see CashCategory.payoutTarget) — "investor" reads linkedInvestorId
// directly, "assigned_manager" means "whichever manager is attached to the
// client picked on THIS order" (Client.createdByManagerId), not one fixed
// manager, since a single "Выплата менеджеру" статья covers every manager.
enum CashCategoryPayoutTarget {
  investor
  assigned_manager
}

// Статья — separate lists for income vs expense (an income статья like
// "приход комиссия" never belongs on an expense order and vice versa).
// Free-form, not an enum, so the owner can add a new статья from the UI
// without a schema migration — same principle as DensityTariff.categoryLabel.
model CashCategory {
  id        String        @id @default(cuid())
  type      CashOrderType
  name      String
  // Set on exactly one income category — the target for entries
  // auto-created by confirm-buyout (see Quote.clientPaymentCashOrderId).
  // Tracked by id (this flag), not by name, so the owner can freely rename
  // this статья without breaking the link.
  isBuyoutIncomeDefault Boolean @default(false)
  // Explicit link from an expense статья (e.g. "Выплата Антон", "Выплата
  // менеджеру") to whoever it pays out — lets the order dialog auto-suggest
  // the amount owed for the client picked on that order instead of the
  // owner hand-computing an investor's share or a manager's premium every
  // time. null on both = no suggestion (e.g. "Закупка товара", a real cost,
  // not a profit-share payout). Tracked by id, not by name, so renaming
  // either the статья or the investor never breaks the link. See PB-V5 chat
  // 2026-08-05.
  payoutTarget          CashCategoryPayoutTarget?
  linkedInvestorId      String?
  linkedInvestor        Investor?                 @relation(fields: [linkedInvestorId], references: [id])
  createdAt DateTime      @default(now())
  orders    CashOrder[]

  @@unique([type, name])
}

model CashOrder {
  id         String        @id @default(cuid())
  type       CashOrderType
  // The ledger date the owner assigns to this operation, not createdAt.
  date       DateTime
  categoryId String
  category   CashCategory  @relation(fields: [categoryId], references: [id])
  // Only ever set for income orders (UI doesn't offer this field for
  // expense) — the same Client used everywhere else in the system, with a
  // quick-create option right from the order dialog.
  clientId   String?
  client     Client?       @relation(fields: [clientId], references: [id])
  // Optional link to a specific quote of `client` — lets the "Приходный/
  // Расходный ордер" dialog auto-suggest an amount scoped to ONE deal
  // (investor share/manager premium owed, or balance still owed by the
  // client) instead of the client's whole history, and shows which quote a
  // ledger entry was actually for. Deliberately separate from
  // QuotePaymentAllocation (the category-by-category "Приходный ордер"
  // created from a quote card, which credits manager premium immediately —
  // see create-payment/route.ts) — this is a lighter-weight reference for
  // the general ledger, not a replacement for that per-category mechanism.
  // Must belong to `client` when both are set — enforced at the API layer,
  // not the schema. See PB-V5 chat 2026-08-06.
  quoteId    String?
  quote      Quote?        @relation("QuoteLedgerCashOrders", fields: [quoteId], references: [id])
  currency   CashCurrency
  // Always positive — type (income/expense) determines the sign when
  // summing into a running balance, so the entry form never asks for a
  // signed number.
  amount     Decimal
  // How many units of `currency` equal 1 CNY ("1 ¥ = X ₽/$"), entered by
  // hand each time (not pulled from TariffSettings — this ledger is
  // intentionally independent) — 1 when currency is cny. Deliberately the
  // SAME quoting direction as TariffSettings.cnyRateRub ("Курс юаня (CNY →
  // RUB)") rather than its inverse — a real owner-entered RUB order was
  // once saved 163x too large because an earlier version of this field
  // asked for the opposite direction (¥ per 1 unit of currency), which
  // doesn't match how a rate is normally quoted/typed for RUB.
  cnyToCurrencyRate Decimal
  // amount / cnyToCurrencyRate (amount for currency=cny), snapshotted at
  // create/edit time so a later edit to the rate on ANOTHER order never
  // silently changes this one's total.
  amountCny  Decimal
  comment    String        @default("")
  createdByManagerId String
  createdByManager   Manager @relation(fields: [createdByManagerId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Back-relation for Quote.clientPaymentCashOrder — a quote's confirmed
  // client-payment fact auto-creates/updates exactly one CashOrder.
  linkedQuote Quote? @relation("QuoteClientPaymentCashOrder")
  // One order created from a quote card (see QuotePaymentAllocation below)
  // can cover pieces of several quotes at once — a plain CashOrder.clientId
  // still identifies who paid, but WHICH quotes/line items it covers lives
  // in these rows instead.
  paymentAllocations QuotePaymentAllocation[]

  @@index([date])
  @@index([categoryId])
  @@index([quoteId])
}

// Which line item of a "Счёт на выкуп" a payment covers — same six
// categories buildBuyoutInvoiceAmounts/buildBuyoutInvoiceRowAmounts already
// split a quote into (lib/desk-services/buyout-invoice-calc.ts), minus
// cargo (never billed through this invoice — see that file's own comment).
enum QuotePaymentCategory {
  goods              // Стоимость товара
  china_delivery     // Доставка по Китаю
  search_service     // Услуга поиска
  custom_production  // Производство под заказ
  buyout_commission  // Комиссия за выкуп
  attached_services  // Доп. услуги (lump sum, not itemized per service row)
}

// One row per (quote, category) slice a single CashOrder actually paid for
// — a руководитель/старший менеджер creating a приходный ордер from a
// quote card can split ONE real payment across several quotes/categories in
// one dialog (e.g. one bank transfer covering "услуга поиска" on 3
// different quotes), so the link lives here rather than on CashOrder
// itself (which only has room for one clientId, not a whole allocation
// breakdown). "How much of category X has quote Y been paid so far" is
// always DERIVED by summing these rows — never cached — same "derive, don't
// cache a running total" convention as CashOpeningBalance's own comment.
// Two things read this sum:
//   1. The buyout invoice (buildBuyoutInvoiceAmounts) subtracts it from
//      each category's full price, so a re-issued счёт only bills the
//      remaining balance — see PB-V5 chat 2026-08-04.
//   2. Manager premium (lib/desk-services/quote-profit.ts) — premiumRub
//      below is frozen at the moment of THIS allocation (self-sourced
//      status looked up live then, never recomputed later, same "lock in
//      at the real-money event" rule as buyoutSelfSourcedBoost), and later
//      confirm-buyout's own premium calculation must subtract what's
//      already been paid out here so the same profit is never premiumed
//      twice.
model QuotePaymentAllocation {
  id          String    @id @default(cuid())
  cashOrderId String
  cashOrder   CashOrder @relation(fields: [cashOrderId], references: [id], onDelete: Cascade)
  quoteId     String
  quote       Quote     @relation(fields: [quoteId], references: [id])
  category    QuotePaymentCategory
  // How much of this order's ₽ amount went to this quote's this category —
  // always ≤ that category's own remaining unpaid balance at creation time
  // (enforced by the creating route, not the schema).
  amountRub   Decimal
  // Manager premium this specific slice generated, frozen at creation —
  // see the model comment above for why this is never recomputed later.
  premiumRub  Decimal
  createdByManagerId String
  createdByManager   Manager @relation(fields: [createdByManagerId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([quoteId])
  @@index([cashOrderId])
}

// Single anchor row: "as of this date, the balance was this many CNY" —
// set once when the owner starts using this ledger (editable later to
// reconcile). Balance at the start/end of ANY period after effectiveDate is
// always DERIVED as anchor + running sum of CashOrder.amountCny, never
// entered by hand month to month.
model CashOpeningBalance {
  id                 String   @id @default(cuid())
  effectiveDate      DateTime
  amountCny          Decimal
  updatedByManagerId String
  updatedByManager   Manager  @relation(fields: [updatedByManagerId], references: [id])
  updatedAt          DateTime @updatedAt
}

// Фулфилмент — warehouse services billed directly to a client (goods
// inspection/repackaging/labelling), a separate business line from the
// Quote-based buyout/cargo flow (see PB-V5 chat 2026-07-28).
//
// Two-level structure (see PB-V5 chat 2026-07-30 — replaces the original
// flat "order → service quantities" shape, which had no concept of a
// physical item at all): an order holds one or more FulfillmentOrderItem
// (a physical product the client dropped off — name/sku/dimensions), each
// of which holds its own FulfillmentOrderItemService lines (which catalog
// services apply to THAT item, and whether the warehouse has done them
// yet). Per-service completion (below) is still the atomic unit of
// physical work; FulfillmentOrder.status is a coarser, manually-set
// summary for the order as a whole (see PB-V5 chat 2026-07-30).
model FulfillmentServiceItem {
  id            String                        @id @default(cuid())
  name          String
  priceRub      Decimal
  createdAt     DateTime                      @default(now())
  itemServices  FulfillmentOrderItemService[]
}

// Free-form, not a blocking pipeline — same "pick any status" philosophy as
// QuoteStatus, just a much shorter list since a fulfillment order's own
// lifecycle is simple (no cargo/buyout side effects to gate on).
enum FulfillmentOrderStatus {
  new_order // новый
  in_progress // в работе
  done // выполнен
  paid // оплачен
}

model FulfillmentOrder {
  id        String   @id @default(cuid())
  displayId Int      @unique
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  // Optional — a client can come in for fulfillment only, with no Quote at
  // all (goods bought elsewhere, just landed on our warehouse).
  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id])
  managerId String
  manager   Manager  @relation(fields: [managerId], references: [id])
  status    FulfillmentOrderStatus @default(new_order)
  // Soft-delete, same convention as Client.archivedAt — an archived order
  // drops out of the default list but isn't gone (unlike an actual DELETE,
  // which this resource also supports for genuine mistakes).
  archivedAt DateTime?
  // Sum of every item's services' priceRub × quantity — snapshotted at
  // creation, not recomputed later. This is the ONLY field the fulfillment
  // premium calc in app/api/manager-dashboard/route.ts reads — item/service
  // detail below is for the warehouse and the order's own record, not
  // anything the premium math depends on.
  totalRub  Decimal
  createdAt DateTime @default(now())
  items     FulfillmentOrderItem[]

  @@index([clientId])
  @@index([managerId])
}

// One physical product/SKU dropped off as part of the order — what the
// warehouse is actually handling. Deliberately order-scoped only, NOT a
// persistent product/SKU catalog: the same SKU showing up in a later order
// creates an entirely new, unrelated row (no cross-order inventory
// tracking — see PB-V5 chat 2026-07-30). sku/dimensions are optional,
// free-text — same "not every field is always known" reasoning as Quote's
// own optional productLink/dimensions.
model FulfillmentOrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      FulfillmentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  dimensions String?
  createdAt  DateTime @default(now())
  services   FulfillmentOrderItemService[]

  @@index([orderId])
}

// One warehouse task (one catalog service) on one item — the atomic unit
// of both billing and physical work. name/priceRub snapshotted, not a live
// reference — same reasoning as QuoteAttachedService, so a later catalog
// price change or deleted service never alters an already-billed order.
//
// completedAt/completedByManagerId is the physical-execution side — null
// means not done yet, a timestamp means done and by whom, same
// "timestamp doubles as boolean + audit trail" pattern as
// Quote.buyoutConfirmedAt/buyoutConfirmedByManagerId. Any manager with
// access to the order can mark a line done — no separate "warehouse" role
// exists in this system, same "day-to-day work, no sign-off needed"
// reasoning already applied to who can create the order at all.
model FulfillmentOrderItemService {
  id                    String                  @id @default(cuid())
  itemId                String
  item                  FulfillmentOrderItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  serviceItemId         String?
  serviceItem           FulfillmentServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  name                  String
  priceRub              Decimal
  quantity              Int
  completedAt           DateTime?
  completedByManagerId  String?
  completedByManager    Manager?                @relation(fields: [completedByManagerId], references: [id])

  @@index([itemId])
}

// A lightweight "don't forget to build this quote" note — the client asked
// for something (maybe just a reference photo or a rough description) but
// there isn't yet enough to build a real Quote (price, weight, dimensions
// etc.). Deliberately minimal (just free text, no structured fields) —
// this is a reminder/inbox item, not a quote in progress; see PB-V5 chat
// 2026-07-28 ("план по поиску что бы не забыть").
// Two authors are possible now (see PB-V5 chat 2026-07-29): a manager
// creating a note on the client's behalf (managerId set), or the client
// submitting their own "ТЗ на просчёт" from /account (managerId null —
// that's the discriminator, no separate boolean to keep in sync). Photos/
// spec files, if any, attach via DeskFile (tab: quote_draft_request,
// relatedId: this row's id) — same polymorphic pattern as every other
// DeskFile-backed attachment in this schema.
model QuoteDraftRequest {
  id        String   @id @default(cuid())
  displayId Int      @unique
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  // Null means the client authored this themselves — see model comment.
  managerId String?
  manager   Manager? @relation(fields: [managerId], references: [id])
  note      String
  // Only ever set on a client-authored request (the client's own "сколько
  // штук" at submission time) — a manager creating a note on the client's
  // behalf has no equivalent field, they just build the real Quote once
  // they pick it up.
  quantity  Int?
  // Marked done once a real Quote has been built for it (or it turned out
  // not to be needed) — done items drop out of the default list rather
  // than accumulating as clutter once handled.
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dailyPlanItems DailyPlanItem[]

  @@index([clientId])
  @@index([managerId])
}

// A manager's personal day plan — "who am I making quotes for today" — a
// lightweight checklist, not a workflow gate; nothing else in the system
// reads doneAt. Deliberately NOT the same thing as QuoteDraftRequest
// ("Черновики"): a plan item can point at a client and/or an existing
// draft for quick context/navigation, but can just as easily be free text
// for a client not in the system yet, or a stray thought — the whole
// point is not forcing structure on a manager jotting things down first
// thing in the morning. See PB-V5 chat 2026-07-31.
model DailyPlanItem {
  id        String   @id @default(cuid())
  managerId String
  manager   Manager  @relation(fields: [managerId], references: [id])
  // The calendar day this item belongs to, stored as that day's UTC
  // midnight — same "day boundary" convention as CashOrder.date. Not the
  // same as createdAt: the UI only ever adds items for today right now,
  // but the field exists so a manager's plan history is genuinely
  // per-day, not just "everything ever added."
  planDate  DateTime
  // Always shown as-is, a snapshot at add time — for a client/draft pick
  // this starts as their name/note, for a free entry it's whatever the
  // manager typed. Not re-derived live from the linked row (renaming a
  // client later shouldn't silently reword an old plan item) — same
  // snapshot reasoning as QuoteAttachedService.name.
  note      String
  // Both optional and independent of each other — a plan item may link
  // neither (pure free text), just a client, just a draft, or both.
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  quoteDraftRequestId String?
  quoteDraftRequest   QuoteDraftRequest? @relation(fields: [quoteDraftRequestId], references: [id])
  // Timestamp doubles as the "done" checkbox + who/when it was checked —
  // same pattern as buyoutConfirmedAt/cargoActualizedAt elsewhere in this
  // schema, rather than a separate boolean.
  doneAt    DateTime?
  createdAt DateTime @default(now())
  // Set only when an owner/senior added this to someone ELSE's plan (see
  // POST /api/manager-daily-plan) — null means the manager whose list this
  // is on added it themselves. Plain string, no Prisma relation — same
  // convention as buyoutConfirmedByManagerId elsewhere in this schema
  // (resolved with one extra manager lookup where needed, not an include).
  assignedByManagerId String?
  // When the assigned manager clicked "Понятно, принято к исполнению" on
  // the pop-up shown for a newly assigned task (see
  // daily-plan-assigned-modal.tsx) — null until then. Only meaningful when
  // assignedByManagerId is set; a manager's own self-added items are never
  // shown in that pop-up, so this just stays null for them forever. See
  // PB-V5 chat 2026-08-03.
  acknowledgedAt DateTime?

  @@index([managerId, planDate])
}

// One row per Telegram group message the ¥→₽ exchange webhook received and
// recognized as a rate post — logged whether or not it actually applied,
// so a failed parse is visible/debuggable instead of silently vanishing.
// See app/api/telegram-cny-rate-webhook/route.ts and PB-V5 chat
// 2026-07-31. Deliberately NOT a confirm-then-apply queue like the manual
// cargo/¥ rate overrides elsewhere in this schema — the owner explicitly
// asked for this one to apply automatically (a new TariffSettings row the
// moment a valid message arrives), just never touching already-issued
// quotes, which the existing "TariffSettings is append-only, a quote
// freezes its own rate at creation" design already guarantees for free.
model TelegramCnyRateUpdate {
  id             String    @id @default(cuid())
  // All four volume tiers the group actually posts, kept for reference/
  // troubleshooting even though only one of them is ever applied.
  rateFrom1000   Decimal?
  rateFrom3000   Decimal?
  rateFrom10000  Decimal?
  rateFrom30000  Decimal?
  // Which tier was actually used — see PARSE_TIER_TO_APPLY in
  // lib/telegram-cny-rate.ts. Null alongside parseError below when the
  // message didn't parse cleanly enough to apply anything.
  appliedRateRub Decimal?
  parseError     String?
  // The TariffSettings row this update created, when successful — kept as
  // a plain string (no relation) since nothing ever needs to query
  // "updates by settings row," only the reverse (which this ID already
  // gives directly).
  tariffSettingsId String?
  rawMessage     String
  receivedAt     DateTime  @default(now())
}
